{{- $events := "" -}}
{{- if .IsHome }}{{ $events = partial "all-events.html" site }}{{ else }}{{ $events = .RegularPagesRecursive.ByDate }}{{ end -}}
{{- $name := cond .IsHome site.Title (printf "%s: %s" site.Title .Title) -}}
{{- partial "ics-calendar.html" (dict "name" $name "events" $events) -}}
